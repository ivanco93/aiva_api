DATABASE_URL=postgresql+asyncpg://<usuario>:<password>@127.0.0.1:5432/aiva
DATABASE_ECHO=false

# Docker Compose
POSTGRES_DB=aiva
POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<password>
POSTGRES_PORT=5432
# Dominio real: pgAdmin rechaza .local, .test, .example...
PGADMIN_EMAIL=<email>
PGADMIN_PASSWORD=<password_pgadmin>
PGADMIN_PORT=5050
